<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <meta name="mobile-web-app-capable" content="yes" />
  <title>Halfway Park Sandbox</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; touch-action: none; }
    body { overflow: hidden; background: #111; font-family: system-ui, sans-serif; color: #fff; }
    #hud {
      position: fixed; top: 10px; left: 10px; z-index: 10;
      background: rgba(15,18,24,0.8); padding: 10px 14px;
      border-radius: 10px; pointer-events: none; max-width: 310px;
    }
    #hud h1 { font-size: 14px; color: #ff9d2e; }
    #hud p { font-size: 11px; color: #e2e8f0; margin-top: 2px; }
    #switch-btn {
      position: fixed; top: 10px; right: 10px; z-index: 15;
      background: #1e293b; color: #fff; border: 1px solid #475569;
      padding: 8px 12px; border-radius: 8px; font-weight: 700; font-size: 12px;
    }
    #crosshair {
      position: fixed; top: 50%; left: 50%; width: 10px; height: 10px;
      margin: -5px 0 0 -5px; border-radius: 50%; border: 2px solid #fff;
      pointer-events: none; z-index: 10;
    }
    #overlay {
      position: fixed; inset: 0; background: rgba(10,12,16,0.95);
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; text-align: center; padding: 16px; z-index: 30;
    }
    .grid {
      display: grid; grid-template-columns: repeat(2, minmax(140px, 195px));
      gap: 10px; margin-top: 16px;
    }
    .card {
      background: #1e293b; border: 2px solid #334155;
      border-radius: 12px; padding: 14px 10px; color: #fff;
    }
    .card:active { border-color: #ff9d2e; }
    .card h3 { font-size: 14px; color: #ff9d2e; margin-bottom: 4px; }
    .card span { font-size: 11px; color: #94a3b8; display: block; }
    #touch-ui { position: fixed; inset: 0; pointer-events: none; z-index: 12; display: none; }
    #joy {
      position: fixed; bottom: 20px; left: 20px; width: 120px; height: 120px;
      border-radius: 50%; background: rgba(255,255,255,0.1);
      border: 2px solid rgba(255,255,255,0.25); pointer-events: auto;
    }
    #knob {
      position: absolute; top: 37px; left: 37px; width: 46px; height: 46px;
      border-radius: 50%; background: rgba(255,157,46,0.85);
    }
    #look { position: fixed; top: 50px; right: 0; width: 55%; height: 55%; pointer-events: auto; }
    .btns {
      position: fixed; bottom: 20px; right: 20px; display: grid;
      grid-template-columns: repeat(3, 60px); gap: 8px; pointer-events: auto;
    }
    .btn {
      height: 52px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.25);
      background: rgba(15,23,42,0.85); color: #fff; font-weight: 700;
      font-size: 11px; display: flex; align-items: center; justify-content: center;
    }
    .btn:active { background: #ff9d2e; color: #111; }
  </style>
</head>
<body>
  <div id="hud">
    <h1 id="t-title">PHYSICS HANDS</h1>
    <p id="t-sub">Peasant (75kg) | Slow-Mo: OFF</p>
    <p id="t-hint" style="color:#94a3b8;">Pick a control mode</p>
  </div>
  <button id="switch-btn">CONTROLS</button>
  <div id="crosshair"></div>

  <div id="overlay">
    <h2 style="color:#ff9d2e;">HALFWAY PARK SANDBOX</h2>
    <p style="font-size:13px; color:#cbd5e1; margin-top:4px;">Select Control Style:</p>
    <div class="grid">
      <button class="card" data-m="touch">
        <h3>1. Touch</h3><span>Stick + Drag Look + Buttons</span>
      </button>
      <button class="card" data-m="motion">
        <h3>2. Motion (Hand Nodon)</h3><span>Tilt to grab, swing & throw</span>
      </button>
      <button class="card" data-m="joycon">
        <h3>3. Joy-Con / 2</h3><span>Sideways or Paired Joy-Con</span>
      </button>
      <button class="card" data-m="pro">
        <h3>4. Pro Controller</h3><span>Dual-Stick Bluetooth Layout</span>
      </button>
    </div>
  </div>

  <div id="touch-ui">
    <div id="joy"><div id="knob"></div></div>
    <div id="look"></div>
    <div class="btns">
      <button class="btn" id="b-cen">CENTER</button>
      <button class="btn" id="b-slw">SLOW</button>
      <button class="btn" id="b-tool">TOOL</button>
      <button class="btn" id="b-alt">ALT</button>
      <button class="btn" id="b-zl" style="background:#0284c7;">ZL/THROW</button>
      <button class="btn" id="b-zr" style="background:#ea580c;">ZR/GRAB</button>
      <button class="btn" id="b-jmp" style="grid-column:span 3; height:42px;">JUMP</button>
    </div>
  </div>

  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com",
        "cannon-es": "https://unpkg.com"
      }
    }
  </script>
  <script type="module">
    import * as THREE from 'three';
    import * as CANNON from 'cannon-es';

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x87a8c9);
    scene.fog = new THREE.Fog(0x87a8c9, 30, 120);
    const camera = new THREE.PerspectiveCamera(75, innerWidth / innerHeight, 0.1, 150);
    const renderer = new THREE.WebGLRenderer({ antialias: false });
    renderer.setPixelRatio(1);
    renderer.setSize(innerWidth, innerHeight);
    document.body.appendChild(renderer.domElement);

    scene.add(new THREE.HemisphereLight(0xffffff, 0x444455, 1.1));
    const dl = new THREE.DirectionalLight(0xfff5e4, 1.2);
    dl.position.set(25, 45, 20);
    scene.add(dl);

    const handGroup = new THREE.Group();
    const handMat = new THREE.MeshLambertMaterial({ color: 0xff9d2e });
    handGroup.add(new THREE.Mesh(new THREE.BoxGeometry(0.28, 0.32, 0.12), handMat));
    const tipGeo = new THREE.ConeGeometry(0.08, 0.22, 10);
    const tip = new THREE.Mesh(tipGeo, new THREE.MeshLambertMaterial({ color: 0xffffff }));
    tip.rotation.x = -Math.PI / 2;
    tip.position.z = -0.18;
    handGroup.add(tip);
    handGroup.visible = false;
    scene.add(handGroup);

    const world = new CANNON.World({ gravity: new CANNON.Vec3(0, -18, 0) });
    world.broadphase = new CANNON.SAPBroadphase(world);
    world.allowSleep = true;
    world.solver.iterations = 6;
    const mat = new CANNON.Material('default');
    const cMat = new CANNON.ContactMaterial(mat, mat, { friction: 0.4, restitution: 0.2 });
    world.addContactMaterial(cMat);

    const objs = [];
    const addBox = (w, h, d, x, y, z, c = 0x555b66) => {
      const m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), new THREE.MeshLambertMaterial({ color: c }));
      m.position.set(x, y, z);
      scene.add(m);
      const b = new CANNON.Body({ mass: 0, material: mat });
      b.addShape(new CANNON.Box(new CANNON.Vec3(w / 2, h / 2, d / 2)));
      b.position.set(x, y, z);
      world.addBody(b);
    };

    const spawnProp = (type, pos) => {
      if (objs.length > 35) {
        const old = objs.shift();
        scene.remove(old.m);
        world.removeBody(old.b);
      }
      let m, s, mass = 15;
      if (type === 'crate') {
        m = new THREE.Mesh(new THREE.BoxGeometry(1.2, 1.2, 1.2), new THREE.MeshLambertMaterial({ color: 0xc28548 }));
        s = new CANNON.Box(new CANNON.Vec3(0.6, 0.6, 0.6));
      } else if (type === 'heavy') {
        m = new THREE.Mesh(new THREE.BoxGeometry(1.6, 1.6, 1.6), new THREE.MeshLambertMaterial({ color: 0x3b4252 }));
        s = new CANNON.Box(new CANNON.Vec3(0.8, 0.8, 0.8));
        mass = 65;
      } else if (type === 'barrel') {
        m = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.5, 1.4, 12), new THREE.MeshLambertMaterial({ color: 0xd94848 }));
        s = new CANNON.Cylinder(0.5, 0.5, 1.4, 10);
        mass = 20;
      } else {
        m = new THREE.Mesh(new THREE.SphereGeometry(0.65, 14, 14), new THREE.MeshLambertMaterial({ color: 0x38bdf8 }));
        s = new CANNON.Sphere(0.65);
        mass = 8;
      }
      m.position.copy(pos);
      scene.add(m);
      const b = new CANNON.Body({ mass, material: mat, linearDamping: 0.05, angularDamping: 0.05 });
      b.addShape(s);
      b.position.set(pos.x, pos.y, pos.z);
      world.addBody(b);
      objs.push({ m, b });
    };

    addBox(90, 2, 90, 0, -1, 0, 0x4b5563);
    addBox(90, 8, 2, 0, 4, -45, 0x374151);
    addBox(90, 8, 2, 0, 4, 45, 0x374151);
    addBox(2, 8, 90, -45, 4, 0, 0x374151);
    addBox(2, 8, 90, 45, 4, 0, 0x374151);
    addBox(14, 3, 14, -15, 1.5, -15, 0x64748b);
    addBox(10, 6, 10, 18, 3, -18, 0x64748b);
    addBox(4, 10, 4, 0, 5, -22, 0xd97706);
    addBox(16, 1, 6, -15, 1.5, -5, 0x94a3b8);
    ['crate', 'barrel', 'sphere', 'heavy'].forEach((t, i) => {
      spawnProp(t, new THREE.Vector3((i - 1.5) * 2.2, 2, -6));
    });
const hp = camera.position.clone().add(off);
handVel.subVectors(hp, prevHand).divideScalar(Math.max(rdt, 0.008));
prevHand.copy(hp);
handGroup.position.copy(hp);
handGroup.quaternion.copy(camera.quaternion);
}
const av = avatars[avIdx];
const fwd = new THREE.Vector3(-Math.sin(yaw), 0, -Math.cos(yaw));
const rgt = new THREE.Vector3(Math.cos(yaw), 0, -Math.sin(yaw));
if (tIdx === 1 && zrH) {
const { d } = ray(10);
pBody.velocity.set(d.x * 18, d.y * 18 + 0.3, d.z * 18);
} else {
const w = new THREE.Vector3().addScaledVector(fwd, -mz).addScaledVector(rgt, mx);
if (w.lengthSq() > 1) w.normalize();
pBody.velocity.x = w.x * av.s;
pBody.velocity.z = w.z * av.s;
if (noclip) pBody.velocity.y = 0;
if (jmp && Math.abs(pBody.velocity.y) < 0.25 && !noclip) pBody.velocity.y = av.j;
}
if (tIdx === 0) {
const hov = !grabB ? findTarget() : grabB;
if (mode === 'motion') handMat.color.setHex(grabB ? 0x22c55e : (hov ? 0x4ade80 : 0xff9d2e));
if (zrH && !grabB && hov) grabB = hov;
else if (!zrH && grabB) {
if (mode === 'motion' && handVel.length() > 3.2) {
const tb = handVel.clone().clampLength(0, 26);
grabB.velocity.set(tb.x, tb.y + 2, tb.z);
}
grabB = null;
}
if (grabB) {
const { d } = ray(10);
const tp = mode === 'motion' ? handGroup.position.clone() : camera.position.clone().addScaledVector(d, hDist);
const wr = Math.min(1, av.g / grabB.mass);
grabB.velocity.set((tp.x - grabB.position.x) * 16 * wr, (tp.y - grabB.position.y) * 16 * wr, (tp.z - grabB.position.z) * 16 * wr);
grabB.angularVelocity.scale(0.82, grabB.angularVelocity);
if (zlP) { grabB.velocity.set(d.x * 22, d.y * 22 + 2, d.z * 22); grabB = null; }
}
} else if (mode === 'motion') handMat.color.setHex(0xff9d2e);
if (tIdx === 2 && zrP) { avIdx = (avIdx + 1) % 5; pBody.mass = avatars[avIdx].m; pBody.updateMassProperties(); hud(); }
if (tIdx === 3) {
if (!pMode) {
if (zrP) {
const { res, d } = ray(35);
const sp = res.hasHit ? new THREE.Vector3(res.hitPointWorld.x + res.hitNormalWorld.x, res.hitPointWorld.y + res.hitNormalWorld.y + 0.5, res.hitPointWorld.z + res.hitNormalWorld.z) : camera.position.clone().addScaledVector(d, 5);
spawnProp(sTypes[sIdx], sp);
}
if (zlP && objs.length) { const l = objs.pop(); scene.remove(l.m); world.removeBody(l.b); }
} else if (zrP || zlP) {
const { res } = ray(60);
if (res.hasHit && res.body.mass === 0) {
const p = zrP ? bPort : oPort; p.act = p.m.visible = true;
p.n.set(res.hitNormalWorld.x, res.hitNormalWorld.y, res.hitNormalWorld.z);
p.m.position.set(res.hitPointWorld.x + p.n.x * 0.05, res.hitPointWorld.y + p.n.y * 0.05, res.hitPointWorld.z + p.n.z * 0.05);
p.m.lookAt(p.m.position.clone().add(p.n));
}
}
}
if (tIdx === 4) {
if (zlH && !gravB) { const { res } = ray(25); if (res.hasHit && res.body?.mass > 0) gravB = res.body; }
else if (!zlH) gravB = null;
if (gravB) {
const { d } = ray(10), hp = camera.position.clone().addScaledVector(d, 3);
gravB.velocity.set((hp.x - gravB.position.x) * 18, (hp.y - gravB.position.y) * 18, (hp.z - gravB.position.z) * 18);
if (zrP) { gravB.velocity.set(d.x * 42, d.y * 42 + 3, d.z * 42); gravB = null; }
} else if (zrP) { const { res, d } = ray(25); if (res.hasHit && res.body?.mass > 0) res.body.velocity.set(d.x * 38, d.y * 38 + 4, d.z * 38); }
}
if (bPort.act && oPort.act && pCool <= 0) {
const tp = b => {
const p = new THREE.Vector3(b.position.x, b.position.y, b.position.z);
if (p.distanceTo(bPort.m.position) < 1.35) {
const e = oPort.m.position.clone().addScaledVector(oPort.n, 1.6); b.position.set(e.x, e.y, e.z);
const s = Math.max(b.velocity.length(), 7); b.velocity.set(oPort.n.x * s, oPort.n.y * s, oPort.n.z * s); pCool = 0.4;
} else if (p.distanceTo(oPort.m.position) < 1.35) {
const e = bPort.m.position.clone().addScaledVector(bPort.n, 1.6); b.position.set(e.x, e.y, e.z);
const s = Math.max(b.velocity.length(), 7); b.velocity.set(bPort.n.x * s, bPort.n.y * s, bPort.n.z * s); pCool = 0.4;
}
};
tp(pBody); objs.forEach(o => tp(o.b));
}
world.step(1 / 60, dt, 3);
camera.position.set(pBody.position.x, pBody.position.y + (av.h - 0.55), pBody.position.z);
objs.forEach(o => { o.m.position.copy(o.b.position); o.m.quaternion.copy(o.b.quaternion); });
renderer.render(scene, camera);
}
window.addEventListener('resize', () => { camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth, innerHeight); });
animate();
    const clock = new THREE.Clock();
    function animate() {
      requestAnimationFrame(animate);
      if (!started) return;
      const rdt = Math.min(clock.getDelta(), 0.05);
      const dt = rdt * (slow ? 0.35 : 1);
      if (pCool > 0) pCool -= rdt;

      let mx = ts.mx, mz = ts.mz, lx = ts.lx, ly = ts.ly;
      ts.lx = ts.ly = 0;
      let jmp = ts.jmp, zrH = ts.zrH, zlH = ts.zlH, zrP = ts.zrP, zlP = ts.zlP;
      ts.jmp = ts.zrP = ts.zlP = false;

      if (mode === 'motion' && bBeta !== null) {
        const dg = Math.max(-38, Math.min(38, gGamma - bGamma));
        const db = Math.max(-38, Math.min(38, gBeta - bBeta));
        handX = Math.max(-0.85, Math.min(0.85, dg / 24));
        handY = Math.max(-0.65, Math.min(0.65, -db / 24));
        if (Math.abs(dg) > 18) yaw -= (dg - Math.sign(dg) * 18) * 0.055 * rdt;
        if (Math.abs(db) > 18) pitch = Math.max(-1.4, Math.min(1.4, pitch - (db - Math.sign(db) * 18) * 0.045 * rdt));
      } else {
        handX = handY = 0;
      }

      const gps = navigator.getGamepads ? navigator.getGamepads() : [];
      const gp = gps || gps;
      if (gp && (mode === 'pro' || mode === 'joycon')) {
        const dz = 0.15;
        if (mode === 'joycon' && gp.axes.length <= 2) {
          mx = Math.abs(gp.axes) > dz ? -gp.axes : 0;
          mz = Math.abs(gp.axes) > dz ? gp.axes : 0;
          if (pressed(gp, 0)) jmp = true;
          if (pressed(gp, 1)) nextTool();
          if (pressed(gp, 2)) { slow = !slow; hud(); }
          if (pressed(gp, 3)) altAct();
          zrH = gp.buttons?.pressed;
          zlH = gp.buttons?.pressed;
          zrP = pressed(gp, 5);
          zlP = pressed(gp, 4);
        } else {
          mx = Math.abs(gp.axes) > dz ? gp.axes : 0;
          mz = Math.abs(gp.axes) > dz ? gp.axes : 0;
          lx += (Math.abs(gp.axes) > dz ? gp.axes : 0) * 2.4 * rdt;
          ly += (Math.abs(gp.axes) > dz ? gp.axes : 0) * 2.0 * rdt;
          if (pressed(gp, 0)) jmp = true;
          if (pressed(gp, 4)) { slow = !slow; hud(); }
          if (pressed(gp, 5)) nextTool();
          if (pressed(gp, 3) && tIdx === 1) altAct();
          if (pressed(gp, 2) && tIdx === 3) { pMode = !pMode; hud(); }
          zrH = gp.buttons?.pressed;
          zlH = gp.buttons?.pressed;
          zrP = pressed(gp, 7);
          zlP = pressed(gp, 6);
          if (tIdx === 3 && !pMode) {
            if (pressed(gp, 15)) { sIdx = (sIdx + 1) % 4; hud(); }
            if (pressed(gp, 14)) { sIdx = (sIdx + 3) % 4; hud(); }
          }
        }
      }

      yaw -= lx;
      pitch = Math.max(-1.45, Math.min(1.45, pitch - ly));
      camera.rotation.order = 'YXZ';
      camera.rotation.y = yaw;
      camera.rotation.x = pitch;

      if (mode === 'motion') {
        const reach = grabB ? hDist : 2.3;
        const off = new THREE.Vector3(handX * 1.8, handY * 1.4 - 0.1, -reach).applyQuaternion(camera.quaternion);
        const hp = camera.position.clone().add(off);
        handVel.subVectors(hp, prevHand).divideScalar(Math.max(rdt, 0.008));
        prevHand.copy(hp);
        handGroup.position.copy(hp);
        handGroup.quaternion.copy(camera.quaternion);
      }

      const av = avatars[avIdx];
      const fwd = new THREE.Vector3(-Math.sin(yaw), 0, -Math.cos(yaw));
      const rgt = new THREE.Vector3(Math.cos(yaw), 0, -Math.sin(yaw));
      if (tIdx === 1 && zrH) {
        const { d } = ray(10);
        pBody.velocity.set(d.x * 18, d.y * 18 + 0.3, d.z * 18);
      } else {
        const w = new THREE.Vector3().addScaledVector(fwd, -mz).addScaledVector(rgt, mx);
        if (w.lengthSq() > 1) w.normalize();
        pBody.velocity.x = w.x * av.s;
        pBody.velocity.z = w.z * av.s;
        if (noclip) pBody.velocity.y = 0;
        if (jmp && Math.abs(pBody.velocity.y) < 0.25 && !noclip) pBody.velocity.y = av.j;
      }

      if (tIdx === 0) {
        const hov = !grabB ? findTarget() : grabB;
        if (mode === 'motion') handMat.color.setHex(grabB ? 0x22c55e : (hov ? 0x4ade80 : 0xff9d2e));
        if (zrH && !grabB && hov) grabB = hov;
        else if (!zrH && grabB) {
