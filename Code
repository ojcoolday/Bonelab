      if (bPort.act && oPort.act && pCool <= 0) {
        const tp = b => {
          const p = new THREE.Vector3(b.position.x, b.position.y, b.position.z);
          if (p.distanceTo(bPort.m.position) < 1.35) {
            const e = oPort.m.position.clone().addScaledVector(oPort.n, 1.6); b.position.set(e.x, e.y, e.z);
            const s = Math.max(b.velocity.length(), 7); b.velocity.set(oPort.n.x * s, oPort.n.y * s, oPort.n.z * s); pCool = 0.4;
          } else if (p.distanceTo(oPort.m.position) < 1.35) {
            const e = bPort.m.position.clone().addScaledVector(bPort.n, 1.6); b.position.set(e.x, e.y, e.z);
            const s = Math.max(b.velocity.length(), 7); b.velocity.set(bPort.n.x * s, bPort.n.y * s, bPort.n.z * s); pCool = 0.4;
          }
        };
        tp(pBody); objs.forEach(o => tp(o.b));
      }

      world.step(1 / 60, dt, 3);
      camera.position.set(pBody.position.x, pBody.position.y + (av.h - 0.55), pBody.position.z);
      objs.forEach(o => { o.m.position.copy(o.b.position); o.m.quaternion.copy(o.b.quaternion); });
      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = innerWidth / innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(innerWidth, innerHeight);
    });
    animate();
  </script>
</body>
</html>
